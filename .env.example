# NodeFlow — variables de entorno (copiar a .env; NUNCA commitear .env)
# El .env está en .gitignore. Las claves también se pueden cargar desde la app.

# Razonamiento en la nube (opcional: sin esto la app corre 100% local)
GEMINI_API_KEY=""

# Inferencia local (Ollama). Default si se omite:
OLLAMA_HOST="http://localhost:11434"

# Modelo local usado para borradores (frontmatter, títulos, tags)
NODEFLOW_LOCAL_MODEL="granite3.3:2b"

# Carpeta de la bóveda de conocimiento (Markdown + frontmatter YAML).
# Vacío = la app usa la última ruta elegida en la UI.
NODEFLOW_VAULT=""
