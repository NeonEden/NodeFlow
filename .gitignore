# Dependencias y artefactos de build (pesados o regenerables)
node_modules/
dist/
target/
src-tauri/target/
src-tauri/gen/

# Registros y temporales
*.log
*.tmp-nf
npm-debug.log*
.DS_Store

# Credenciales — NUNCA al repo
.env
.env.local
*.key

# Demo web: las claves que sólo viven en el servidor (NUNCA al repo)
# `demo/public/` SÍ se versiona (968 KB, 4 archivos): Vercel sirve el demo como estático y su
# buildCommand es un no-op a propósito, así que el bundle tiene que estar en el repo o el deploy
# falla con «No Output Directory named "public" found». Se regenera con `node demo/build.mjs` y se
# commitea: si tocás el front, acordate de regenerarlo.
demo/clave-assemblyai.txt
demo/clave-motor.txt

# Datos locales de la app (solo en la raíz; src/data/ es código fuente)
/data/
vp.js

# Voz local (Kokoro): modelo y entorno, fuera del repo (~340 MB)
tools/tts/.venv/
tools/tts/*.onnx
tools/tts/voices-*.bin
tools/tts/*.wav
# manifiesto temporal del updater: se genera al publicar
latest.json

# Demo: materias primas crudas (traen datos de la máquina del autor)
demo/fixtures-crudas/
.vercel
